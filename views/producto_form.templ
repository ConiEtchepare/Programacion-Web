package views

templ ProductoForm() {
	<article>
		<h2> Agregar Producto</h2>
		<form action="/productos" method="POST">
			<label for="nombre">
				Nombre del Producto:
				<input type="text" id="nombre" name="nombre" placeholder="Ej: Castañas de Cajú W4" required/>
			</label>
			<label for="categoria">
				Categoría:
				<input type="text" id="categoria" name="categoria" placeholder="Ej: Frutos Secos" required/>
			</label>
			<label for="precio">
				Precio ($):
				<input type="number" id="precio" name="precio" step="0.01" placeholder="Ej: 12500.50" required/>
			</label>
			<button type="submit">Guardar Producto</button>
		</form>
	</article>
}
